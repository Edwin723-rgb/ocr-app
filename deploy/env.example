# Copia este archivo a la raíz del proyecto como ".env" antes de docker compose up
# cp deploy/env.example .env

# Puerto HTTP expuesto en el host (nginx). En VPS suele ser 80.
OCR_HTTP_PORT=8080

# Obligatorio en producción: clave que el equipo ingresa en la web
OCR_API_KEY=cambia-esta-clave-por-una-segura

# Opcional: OCR con Gemini (firmas, sellos y documentos complejos)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OCR_SUPPLEMENTARY_PASS=1

# Límite de subida (debe coincidir con client_max_body_size en deploy/nginx.conf)
MAX_UPLOAD_MB=300

# Trabajos pesados (PDFs grandes / muchas páginas)
OCR_HEAVY_ASYNC_MB=15
OCR_HEAVY_ASYNC_PAGES=35
OCR_MAX_CONCURRENT_JOBS=1
OCR_CHUNK_PAGES=8

# Rendimiento (ajústalo según CPU/RAM del servidor)
OCR_TESSERACT_WORKERS=4
OCR_GEMINI_WORKERS=2

# Cloudflare Tunnel (solo en VPS con deploy/CLOUDFLARE.md)
# CLOUDFLARE_TUNNEL_TOKEN=
