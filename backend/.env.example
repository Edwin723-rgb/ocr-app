# Deja vacío para uso local sin clave. En servidor por URL, define una clave fuerte.
# OCR_API_KEY=sci-ocr-2024
OCR_API_KEY=
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
GEMINI_API_KEY=
# Modelo Gemini (requiere API key). Ej: gemini-2.0-flash, gemini-2.5-flash
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI (GPT-4o visión) — opcional, mejora OCR en escaneos difíciles
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o

# Anthropic (Claude) — opcional
# ANTHROPIC_API_KEY=
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Motor IA: auto | gemini | openai | anthropic
# OCR_VISION_PROVIDER=auto
# Modo visión: parallel (todos a la vez, elige el mejor) | single (secuencial)
# OCR_VISION_MODE=parallel
# Prioridad cuando es auto (orden de preferencia al elegir resultado)
# OCR_VISION_PRIORITY=anthropic,openai,gemini
# OCR_VISION_TIMEOUT=120
# Segundos sin reintentar un proveedor tras cupo/límite (429, etc.)
# OCR_VISION_QUOTA_COOLDOWN=300

# OCR_DPI_BALANCED=220
# OCR_UPSCALE_BALANCED=1200
# OCR_BALANCED_GOOD_SCORE=36
# OCR_SUPPLEMENTARY_PASS=0

# Motor OCR (recomendado: solo Tesseract)
# OCR_TESSERACT_ONLY=1          # Sin IA; solo Tesseract local
# OCR_USE_LAYOUT=1              # Reconstruye texto línea por línea (mejor que bloque único)
# OCR_FIX_ROTATION=0            # 0 = no voltear páginas; 1 = OSD conservador
# OCR_PADDLE_ENABLED=0          # 1 = Tesseract + PaddleOCR; elige el mejor por puntuación
# OCR_PADDLE_LAYOUT=1           # 1 = vista demo con bloques y cajas (requiere Paddle)
# OCR_PADDLE_LANG=es            # Idioma Paddle (documentos legales en español)
# OCR_PADDLE_DEVICE=cpu         # cpu | gpu (si tienes CUDA)
# OCR_PADDLE_DET_LIMIT=4000     # Límite lado detección Paddle (px)
# OCR_VISION_ENABLED=0          # IA desactivada
# OCR_VISION_TABLES_ONLY=0
# OCR_VISION_DOCS_ONLY=0
# OCR_VISION_LEGAL_ONLY=0

# Trabajos pesados:
# OCR_HEAVY_ASYNC_MB=15
# OCR_HEAVY_ASYNC_PAGES=35
# OCR_MAX_CONCURRENT_JOBS=1
# OCR_CHUNK_PAGES=8
# OCR_ASYNC_ALWAYS=0

# PDFs grandes (≥50 páginas por defecto): modo rápido automático
# OCR_LARGE_PDF_PAGES=50
# OCR_LARGE_PDF_GEMINI_MAX=45
# OCR_LARGE_DPI=200

# Despliegue Docker / servidor (opcional en Windows local)
# MAX_UPLOAD_MB=300
# OCR_HOST=0.0.0.0
# OCR_PORT=8000
